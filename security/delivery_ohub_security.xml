<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="delivery_shipping_order_company_rule" model="ir.rule">
            <field name="name">Delivery Shipping Order Multi-Company</field>
            <field name="model_id" ref="model_delivery_shipping_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="delivery_shipping_order_log_company_rule" model="ir.rule">
            <field name="name">Delivery Shipping Order Log Multi-Company</field>
            <field name="model_id" ref="model_delivery_shipping_order_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
