<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_address_mapping_tree" model="ir.ui.view">
        <field name="name">delivery.address.mapping.list</field>
        <field name="model">delivery.address.mapping</field>
        <field name="arch" type="xml">
            <list string="Address Mappings" decoration-danger="state == 'unmatched'" decoration-success="state == 'matched'">
                <field name="carrier_id"/>
                <field name="state_id"/>
                <field name="oris_ward_id"/>
                <field name="external_province_id"/>
                <field name="external_district_id"/>
                <field name="external_ward_code"/>
                <field name="external_ward_name"/>
                <field name="match_method"/>
                <field name="is_default"/>
                <field name="state" widget="badge" decoration-success="state == 'matched'" decoration-danger="state == 'unmatched'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_address_mapping_form" model="ir.ui.view">
        <field name="name">delivery.address.mapping.form</field>
        <field name="model">delivery.address.mapping</field>
        <field name="arch" type="xml">
            <form string="Address Mapping">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="2-Level Administrative Division">
                            <field name="state_id" options="{'no_create': True}"/>
                            <field name="oris_ward_id" options="{'no_create': True}"/>
                            <field name="carrier_id"/>
                            <field name="hub_flow_id"/>
                        </group>
                        <group string="Carrier Technical Codes (GHN / GHTK, etc.)">
                            <field name="external_ward_code"/>
                            <field name="external_ward_name"/>
                            <field name="external_district_id"/>
                            <field name="external_district_name"/>
                            <field name="external_province_id"/>
                            <field name="external_province_name"/>
                            <field name="match_method"/>
                            <field name="is_default"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_address_mapping_search" model="ir.ui.view">
        <field name="name">delivery.address.mapping.search</field>
        <field name="model">delivery.address.mapping</field>
        <field name="arch" type="xml">
            <search string="Search Address Mappings">
                <field name="state_id"/>
                <field name="oris_ward_id"/>
                <field name="external_ward_code"/>
                <field name="external_ward_name"/>
                <filter string="Matched" name="filter_matched" domain="[('state', '=', 'matched')]"/>
                <filter string="Unmatched" name="filter_unmatched" domain="[('state', '=', 'unmatched')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="State / Province" name="group_by_state" context="{'group_by': 'state_id'}"/>
                    <filter string="Delivery Method" name="group_by_carrier" context="{'group_by': 'carrier_id'}"/>
                    <filter string="Status" name="group_by_state_mapping" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_delivery_address_mapping" model="ir.actions.act_window">
        <field name="name">ORIS - Carrier Address Mappings</field>
        <field name="res_model">delivery.address.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_matched': 1}</field>
    </record>
</odoo>
