<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_ohub_operation_tree" model="ir.ui.view">
        <field name="name">delivery.ohub.operation.list</field>
        <field name="model">delivery.ohub.operation</field>
        <field name="arch" type="xml">
            <list string="oHUB Integration Operations">
                <field name="sequence" widget="handle"/>
                <field name="carrier_id"/>
                <field name="hub_flow_id"/>
                <field name="operation_type"/>
                <field name="name"/>
                <field name="request_id"/>
                <field name="execution_mode"/>
                <field name="show_on_sale_order"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_ohub_operation_form" model="ir.ui.view">
        <field name="name">delivery.ohub.operation.form</field>
        <field name="model">delivery.ohub.operation</field>
        <field name="arch" type="xml">
            <form string="oHUB Integration Operation">
                <sheet>
                    <group>
                        <group string="Business Link">
                            <field name="carrier_id"/>
                            <field name="hub_flow_id"/>
                            <field name="operation_type"/>
                            <field name="name"/>
                        </group>
                        <group string="Execution Configuration">
                            <field name="request_id" domain="[('flow_id', '=', hub_flow_id)]"/>
                            <field name="execution_mode"/>
                            <field name="button_style"/>
                            <field name="show_on_sale_order"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_delivery_ohub_operation" model="ir.actions.act_window">
        <field name="name">oHUB Integration Operations</field>
        <field name="res_model">delivery.ohub.operation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
