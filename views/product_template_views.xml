<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_template_property_form_inherit_delivery_ohub" model="ir.ui.view">
        <field name="name">product.template.form.inherit.delivery.ohub</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='volume']" position="after">
                <label for="length" string="Dimensions (L x W x H)"/>
                <div class="o_row">
                    <field name="length" class="oe_inline"/> x
                    <field name="width" class="oe_inline"/> x
                    <field name="height" class="oe_inline"/> cm
                </div>
            </xpath>
        </field>
    </record>
</odoo>
